SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (same DB as GesAFPED)
DB_NAME=gesafped26
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS — Next.js frontends
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Axes brute-force
# Échecs pour UN compte depuis une adresse, puis pour une adresse tous comptes confondus
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
LOGIN_ECHECS_PAR_IP=20

# Notifications push vers l'app étudiante : clé du compte de service Firebase
# (SECRET, hors git). Vide → aucun push. En Docker : secrets/firebase-iss.json.
# FIREBASE_CREDENTIALS=C:/SIR/ISS_SIGA/backend_iss/secrets/firebase-iss.json
# App enseignant (autre projet Firebase). En Docker : secrets/firebase-iss-enseignant.json.
# FIREBASE_CREDENTIALS_ENSEIGNANT=C:/SIR/ISS_SIGA/backend_iss/secrets/firebase-iss-enseignant.json

# Cache Redis — DEV : laisser commente (fallback LocMemCache automatique)
# PROD multi-worker : activer cette ligne pour cache RBAC partage entre workers
# REDIS_URL=redis://localhost:6379/1
