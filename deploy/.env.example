# ═══════════════════════════════════════════════════════════════
# Variables d'environnement SIGA
# Copie ce fichier en .env et remplis les valeurs reelles.
# Le fichier .env n'est PAS versionne (cf .gitignore).
# ═══════════════════════════════════════════════════════════════

# Domaine ou IP servi par Nginx
# Exemples : siga.iss.mr  /  siga.local  /  192.168.1.50
DOMAIN=siga.local

# Cle Django (genere avec : python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=REMPLACE-PAR-UNE-CLE-ALEATOIRE-DE-50-CARACTERES

# Mot de passe BD (utilisateur 'siga')
DB_PASSWORD=ChangeMoiUnMdpFort2026

# Mot de passe root MySQL (utilise pour les sauvegardes / admin)
DB_ROOT_PASSWORD=ChangeMoiUnAutreMdpFort2026

# ── Déploiement sur VPS MUTUALISÉ (plusieurs instances sur la même machine) ──
# Sans ces variables, le comportement est inchangé : HTTPS sur 443, redirection
# depuis 80, cookies Secure — c'est-à-dire une machine dédiée.
#
# Sur un VPS où 80, 443, 8080 et 9090 servent déjà à d'autres instances :
#   SIGA_NGINX_CONF=./nginx.vps-http.conf
#   SIGA_WEB_PORT=7080            # port publié sur l'hôte
#   SIGA_WEB_PORT_INTERNAL=80     # port écouté DANS le conteneur nginx
#   SIGA_HTTP_PORT=127.0.0.1:7079 # neutralise la redirection 80, qui n'a pas
#                                 # lieu d'être sans TLS (et 80 est pris)
#   SIGA_ADMINER_PORT=8093        # 8091 et 8092 peuvent déjà servir
#   DJANGO_COOKIE_SECURE=False    # OBLIGATOIRE en HTTP : un cookie Secure n'est
#                                 # jamais renvoyé sur http://, donc pas de login
#   DOCUMENTS_BASE_URL=http://<IP>:7080
#
# Le nom de projet Compose doit lui aussi être distinct, sinon les volumes et le
# réseau se confondent avec ceux d'une autre instance :
#   docker compose -p iss up -d
